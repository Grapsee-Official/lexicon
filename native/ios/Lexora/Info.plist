<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <!-- Display name shown under the app icon on the home screen. -->
    <key>CFBundleDisplayName</key>
    <string>Lexicon</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>

    <key>CFBundleVersion</key>
    <string>1</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!--
      UIAppFonts — uncomment & add entries AFTER dragging the Google Fonts
      .ttf files into Resources/. See LexiconTypography.swift for the
      exact file names expected. Without these keys, the app falls back
      gracefully to system serif / sans-serif.

      To enable custom fonts, remove the <true/> value comments below and
      replace the empty <array/> with the entries shown in the comments.
    -->
    <key>UIAppFonts</key>
    <array>
        <!-- <string>Fraunces-Regular.ttf</string> -->
        <!-- <string>Fraunces-Medium.ttf</string> -->
        <!-- <string>Fraunces-SemiBold.ttf</string> -->
        <!-- <string>Inter-Regular.ttf</string> -->
        <!-- <string>Inter-Medium.ttf</string> -->
        <!-- <string>Inter-SemiBold.ttf</string> -->
        <!-- <string>Lora-Regular.ttf</string> -->
        <!-- <string>Lora-Italic.ttf</string> -->
    </array>

    <!--
      UILaunchScreen — empty dict gives a plain warm-cream launch screen
      (the system fills with the app's default background).
      To use a custom launch storyboard, set:
        UILaunchStoryboardName = LaunchScreen
      and add LaunchScreen.storyboard to the project.
    -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>AccentColor</string>
    </dict>

    <!-- Required for full-bleed edge-to-edge UI (matches web viewportFit=cover). -->
    <key>UIRequiresFullScreen</key>
    <false/>

    <!-- Portrait-only on iPhone (matches the web's mobile-only layout). -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- iPad supports all orientations for tablet use. -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- No status-bar hiding — Lexicon keeps the system bar transparent over the warm cream bg. -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>

    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>

    <!-- Disable phone auto-detection in text (mirrors web `formatDetection`). -->
    <key>CFBundleURLTypes</key>
    <array/>

    <!-- App does not use exempt encryption — keeps App Store review simple. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!--
      ITSAppUsesNonExemptEncryption = false + the NS... usage descriptions
      below are reserved for Phase 3 features (camera search, microphone voice
      search, photo library). They are commented out for now.
    -->
    <!--
    <key>NSCameraUsageDescription</key>
    <string>Lexicon uses the camera to scan and look up words.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Lexicon uses the microphone for voice search.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Lexicon can save word illustrations to your photo library.</string>
    -->
</dict>
</plist>
